;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Moai Jungle"
config/description="Este juego fue creado por un proyecto y se ha ido actualizadon por aburrimiento, disfrutalo."
config/version="1.0"
config/tags=PackedStringArray("moai_jungle")
run/main_scene="res://Scenes/menu.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/image="res://images/moai_ejecu.png"
config/icon="res://images/moai_ejecu.png"
config/windows_native_icon="res://Icono_EXE.ico"
config/name.editor="Alesis124"
config/description.editor_runtime="Juego hecho por Alesis124"

[autoload]

GlobalAudio="*res://Scripts/Master/GlobalAudio.gd"
Efectos="*res://Scripts/Master/Efectos.gd"
Global="*res://Scripts/Master/Global.gd"

[display]

window/stretch/mode="canvas_items"

[editor]

version_control/autoload_on_startup=true

